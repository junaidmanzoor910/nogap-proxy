# Copy to workstation-proxy.env (same directory), chmod 600, fill in values.
# Source from your shell:  source scripts/workstation-proxy.env
#
# Do not commit workstation-proxy.env (gitignored).

export NOGAP_PROXY_HOST="${NOGAP_PROXY_HOST:-proxy-dev.nogap.ai}"
export NOGAP_PROXY_PORT="${NOGAP_PROXY_PORT:-443}"

# Squid basic auth (from provision-user.sh on EC2)
export NOGAP_PROXY_USER="${NOGAP_PROXY_USER:-proxyuser01}"
export NOGAP_PROXY_PASS=''

# Standard tools (curl, Node fetch, Python requests, AWS CLI with HTTPS)
_PROXY_URL="https://${NOGAP_PROXY_USER}:${NOGAP_PROXY_PASS}@${NOGAP_PROXY_HOST}:${NOGAP_PROXY_PORT}"
export HTTPS_PROXY="${_PROXY_URL}"
export HTTP_PROXY="${_PROXY_URL}"
export ALL_PROXY="${_PROXY_URL}"

# Keep local services DIRECT (local inbound / Docker on localhost)
export NO_PROXY="localhost,127.0.0.1,::1,.local"
export no_proxy="${NO_PROXY}"

unset _PROXY_URL
