client
dev tun
proto tcp
remote 35.154.197.35 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
verb 3
mute 10

# Prevent routing loop: Pin connection to EC2 through physical gateway
route 35.154.197.35 255.255.255.255 net_gateway
redirect-gateway def1 bypass-dhcp

# Prevent IPv6 leaks: Forces Chrome and all apps to use the IPv4 VPN tunnel
block-ipv6

