# Local forwarder: listens on loopback, authenticates to EC2 Squid (TLS parent).
# Generated by scripts/start-local-forwarder.sh — do not commit rendered file.

acl local_clients src 127.0.0.1/32 ::1/128
acl docker_clients src 172.16.0.0/12 10.0.0.0/8 192.168.0.0/16
http_access allow local_clients
http_access allow docker_clients
http_access deny all

http_port ${LOCAL_LISTEN_PORT}

acl SSL_ports port 443
cache_peer ${UPSTREAM_HOST} parent ${UPSTREAM_PORT} 0 no-query no-digest \
    login=${UPSTREAM_USER}:${UPSTREAM_PASS} ssl sslflags=DONT_VERIFY_PEER default

# Solution 1: Smart Split Proxy
# Only route NoGap APIs and AWS Cloud Services through EC2 (35.154.197.35)
# Everything else (Google, Fonts, CDNs, GitHub, npm) goes DIRECT with 0ms proxy latency
acl nogap_proxy_targets dstdomain .nogap.ai .amazonaws.com .amazoncognito.com .ipify.org
always_direct deny nogap_proxy_targets
always_direct allow all
never_direct allow nogap_proxy_targets
never_direct deny all

client_persistent_connections on
server_persistent_connections on
pconn_timeout 120 seconds

cache_dir ufs ${STATE_DIR}/cache 100 16 256
cache deny all
via off
forwarded_for delete

pid_filename ${STATE_DIR}/squid.pid
coredump_dir ${STATE_DIR}
access_log daemon:${STATE_DIR}/access.log squid
cache_log ${STATE_DIR}/cache.log

visible_hostname nogap-local-forwarder
