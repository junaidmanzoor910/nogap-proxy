# Copy to terraform.tfvars (gitignored if you add local-only values).
# Do not store secrets here.

aws_profile              = "dev"
aws_region               = "us-east-1"
project_name             = "nogap-split-proxy"
proxy_hostname           = "proxy-dev.nogap.ai"
allowed_destination_domain = "app-dev.nogap.ai"
instance_type            = "t3.small"
root_volume_size_gib     = 20
pac_https_port           = 8443
proxy_https_port         = 443

# Tighten if all client egress IPs are known:
# proxy_client_cidr_ipv4 = "203.0.113.0/24"

enable_ipv6_ingress = false
